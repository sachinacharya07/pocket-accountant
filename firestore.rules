rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile doc
    // (fields: allowance, goal: { name, target, saved })
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ...and their own expenses subcollection
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
